/**
 * ===================================================
 *              GLOBAL CONSTANTS
 * ===================================================
 */

// --- Sheet Names ---
const TRADES_SHEET_NAME = "Trades"; // Used by both functions
const CGT_SHEET_NAME = "CGT Calculator";
const PORTFOLIO_SUMMARY_SHEET_NAME = "Portfolio Summary";

// --- CGT Calculator Sheet Constants ---
const FY_CELL = "B1"; // Cell containing the Financial Year dropdown (e.g., "2024-2025")
const FY_START_CELL = "B2"; // Cell with the calculated FY Start Date
const FY_END_CELL = "B3"; // Cell with the calculated FY End Date
const CGT_OUTPUT_START_ROW = 8; // Row where the CGT results start
const CGT_OUTPUT_START_COL = 1; // Column where results start (1 = A)

// --- Portfolio Summary Sheet Constants ---
const PS_DETAIL_START_ROW = 13; // Row where the detailed stock breakdown starts
const PS_DETAIL_START_COL = 1;  // Column where details start (1 = A)
const PS_SUMMARY_VALUE_COL = 3; // Column C where summary totals are placed
const PS_SUMMARY_ROWS = { // Row numbers for the summary figures at the top
  marketValue: 3,
  costBase: 4,
  unrealized: 5,
  realized: 6,
  totalGainLoss: 7,
  numHoldings: 8
};
const DELISTED_TICKERS_RANGE = "C10"; // Cell on Portfolio Summary sheet with comma-separated list of written-off tickers (e.g., "ME1,XYZ")

// --- Trades Sheet Column Indices (0-based index for arrays) ---
// Used by CGT Calculator
const COL_IDX_TRADE_DATE = 0;      // Column A
const COL_IDX_SETTLEMENT_DATE = 1; // Column B
const COL_IDX_ACTION = 2;          // Column C
const COL_IDX_CODE = 4;            // Column E
const COL_IDX_NAME = 5;            // Column F
const COL_IDX_UNITS = 6;           // Column G
const COL_IDX_TOTAL = 10;          // Column K
// Used by Portfolio Summary (ensure consistency if sheet structure is identical)
const COL_IDX_PS_SETTLEMENT_DATE = 1; // Column B
const COL_IDX_PS_ACTION = 2;          // Column C
const COL_IDX_PS_CODE = 4;            // Column E
const COL_IDX_PS_NAME = 5;            // Column F
const COL_IDX_PS_UNITS = 6;           // Column G
const COL_IDX_PS_TOTAL = 10;          // Column K

/**
 * Simple trigger that automatically runs when a user edits the spreadsheet.
 */
function onEdit(e) {
  const range = e.range;
  const sheet = range.getSheet();
  const sheetName = sheet.getName();
  const cellAddress = range.getA1Notation();

  // --- Configuration Check ---
  if (sheetName === CGT_SHEET_NAME &&
      cellAddress === FY_CELL &&
      range.getNumRows() === 1 &&
      range.getNumColumns() === 1) {

    Logger.log(`Edit detected in ${sheetName}!${cellAddress}. Running calculateCGT...`);
    try {
        calculateCGT();
        Logger.log(`calculateCGT finished successfully after edit in ${FY_CELL}.`);
    } catch (error) {
        Logger.log(`Error running calculateCGT automatically from onEdit trigger: ${error} \n${error.stack}`);
    }
  }
}

